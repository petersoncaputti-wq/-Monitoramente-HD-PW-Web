# ProjectWise Explorer user export
# Copy this file to .env.local and fill in the values for your environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Local-only visual preview. Never enable this setting in production.
# VITE_E365_LOCAL_PREVIEW=true

# Azure PostgreSQL runtime
DB_HOST=your-server.postgres.database.azure.com
DB_NAME=your_database
DB_USER=your_application_user
DB_PASSWORD=your_application_password
DB_PORT=5432
DB_SSL=true

# Schema migration only. Do not keep administrator credentials in the App Service.
DB_MIGRATION_USER=your_migration_user
DB_MIGRATION_PASSWORD=your_migration_password
# Server-side only. Never prefix this variable with VITE_ or expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

PW_DATASOURCE_NAME=YourProjectWiseDatasource
PW_AUTH_MODE=password
PW_USERNAME=your_projectwise_user
PW_PASSWORD=your_projectwise_password
PW_INACTIVE_DAYS=180

# Kartado API (somente no servidor; nunca use o prefixo VITE_)
KARTADO_API_URL=https://api.kartado.com.br
KARTADO_USERNAME=seu-usuario-kartado
KARTADO_PASSWORD=sua-senha-kartado

# Optional automatic sources used by other dashboard tabs.
# VITE_STORAGE_SOURCE_URL=https://example.com/file.xlsx
# STORAGE_SYNC_SOURCE_PATH=C:\Path\To\armazenamento.xlsx
# STORAGE_IMPORT_SOURCE_DIR=C:\Path\To\DailyCsvFolder
# STORAGE_IMPORT_SOURCE_PATH=C:\Path\To\historico_2026-07-12.csv
# TICKETS_SOURCE_PATH=C:\Path\To\chamados.xlsx
# PORTAL_USERS_SOURCE_PATH=C:\Path\To\usuarios-pw-portal.xlsx
