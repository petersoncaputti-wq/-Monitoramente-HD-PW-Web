# Copy this file to .env.local and fill in the values for your environment.
# Local-only visual preview. Never enable this setting in production.
# VITE_E365_LOCAL_PREVIEW=true

# Azure PostgreSQL runtime
DB_HOST=your-server.postgres.database.azure.com
DB_NAME=your_database
DB_USER=your_application_user
DB_PASSWORD=your_application_password
DB_PORT=5432
DB_SSL=true

# Login SAML 2.0 com Microsoft Entra ID. Desativado até configurar e homologar.
SAML_ENABLED=false
SAML_PUBLIC_ORIGIN=https://seu-painel.azurewebsites.net
SAML_ENTRA_TENANT_ID=
# Padrão: <SAML_PUBLIC_ORIGIN>/api/auth/saml/metadata
SAML_SP_ENTITY_ID=
# Certificado público Base64/PEM de assinatura SAML do Entra, com BEGIN/END CERTIFICATE.
# Aceita quebras de linha reais ou literais \n; vários PEMs permitem rotação.
SAML_IDP_CERT=
# Opcionais: assinatura de AuthnRequests. Configure o par somente no servidor.
SAML_SP_PRIVATE_KEY=
SAML_SP_CERT=

# Schema migration only. Do not keep administrator credentials in the App Service.
DB_MIGRATION_USER=your_migration_user
DB_MIGRATION_PASSWORD=your_migration_password

# Coletor de armazenamento (POST /api/storage-readings). Chave aleatória de 32+ caracteres.
STORAGE_COLLECTOR_TOKEN=

# Content Security Policy: em modo relatório por padrão; "true" passa a bloquear.
# CSP_ENFORCE=true

# Exportação de usuários do ProjectWise Explorer (scripts/export-pw-users.ps1).
PW_DATASOURCE_NAME=YourProjectWiseDatasource
PW_AUTH_MODE=password
PW_USERNAME=your_projectwise_user
PW_PASSWORD=your_projectwise_password
PW_INACTIVE_DAYS=180

# Kartado API (somente no servidor; nunca use o prefixo VITE_)
KARTADO_API_URL=https://api.kartado.com.br
KARTADO_USERNAME=seu-usuario-kartado
KARTADO_PASSWORD=sua-senha-kartado
# Cache dos dashboards no backend (padrão: 10 minutos)
KARTADO_CACHE_TTL_MS=600000

# Apontamentos: auditor (nova aba) ou legacy (reversão explícita).
# A chave deve ficar somente no servidor, nunca em uma variável VITE_.
KARTADO_REPORTINGS_PROVIDER=auditor
AGENTE_AUDITOR_BASE_URL=https://ecorodovias-agent-api-prod.azurewebsites.net
KARTADO_INVENTORY_SNAPSHOTS=true
MONITORAMENTO_API_KEY=

# Chave compartilhada pelo conector do Copilot Studio. Gere um valor aleatório forte.
COPILOT_API_KEY=substitua-por-uma-chave-aleatoria-forte

# Link de compartilhamento do agente publicado no Microsoft Teams.
# Esta configuração é incorporada no frontend durante o build.
VITE_TEAMS_AGENT_URL=https://teams.microsoft.com/l/entity/SEU_APP_ID
