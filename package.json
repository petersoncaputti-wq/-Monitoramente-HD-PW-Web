{
  "name": "monitoramento-hd-pw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:storage": "node scripts/sync-storage-source.mjs",
    "sync:tickets": "node scripts/sync-tickets-source.mjs",
    "sync:portal-users": "node scripts/sync-portal-users-source.mjs",
    "sync:data": "npm run sync:storage && npm run sync:tickets && npm run sync:portal-users",
    "db:migrate": "node scripts/apply-azure-schema.mjs",
    "legacy:supabase:import-storage": "node scripts/import-storage-to-supabase.mjs",
    "legacy:supabase:import-tickets": "node scripts/import-tickets-to-supabase.mjs",
    "legacy:supabase:create-user": "node scripts/create-auth-user.mjs",
    "legacy:supabase:sync-profiles": "node scripts/sync-auth-profiles.mjs",
    "export:pw-users": "node scripts/export-pw-users-to-xlsx.mjs",
    "dev": "npm run sync:data && vite",
    "build": "tsc -b && vite build",
    "build:with-sync": "npm run sync:data && npm run build",
    "preview": "vite preview",
    "start": "node server.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
